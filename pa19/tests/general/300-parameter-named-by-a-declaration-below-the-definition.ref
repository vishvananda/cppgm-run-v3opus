function @constant_three(%ignored : i32) -> i32 [binding=strong, object=_Z14constant_threei] {
  slot $ignored : i32

  block ^entry:
    store i32 %ignored, $ignored
    return i32 3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @constant_three(4)
    %t2 = binary sub i32 %t1, 3
    return i32 %t2
}
