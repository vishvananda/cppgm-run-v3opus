function @box__operator_(%this : ptr, %source : ptr [pass=reference]) -> ptr [unwind=no, binding=strong, object=_ZN3boxaSERKS_] {
  slot $this : ptr
  slot $source : ptr

  block ^entry:
    store ptr %this, $this
    store ptr %source, $source
    %t1 = load ptr $this
    %t2 = load ptr $source
    copyobj 4x4 %t2, %t1
    %t3 = load ptr $this
    return ptr %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $first : obj<4x4>
  slot $second : obj<4x4>

  block ^entry:
    %t1 = addr $first
    %t2 = addr $second
    %t3 = addr $first
    %t4 = index i8 [projection=field] %t3, 0
    store i32 4, %t4
    %t5 = addr $second
    %t6 = addr $first
    %t7 = call ptr @box__operator_(%t5, %t6)
    %t8 = addr $second
    %t9 = index i8 [projection=field] %t8, 0
    %t10 = load i32 %t9
    return i32 %t10
}
