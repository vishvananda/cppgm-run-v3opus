function @run(%selector : i32) -> i32 [binding=strong, object=_Z3runi] {
  slot $selector : i32
  slot $total : i32
  slot $counted : i32
  slot $held : i32
  slot $rounds : i32

  block ^entry:
    store i32 %selector, $selector
    store i32 0, $total
    %t1 = load i32 $selector
    %t2 = cmp eq i32 %t1, 0
    branch %t2, ^if_then_1, ^if_else_2

  block ^if_then_1:
    jump ^goto_4

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t3 = load i32 $selector
    %t4 = cmp eq i32 %t3, 1
    branch %t4, ^if_then_5, ^if_else_6

  block ^if_then_5:
    jump ^goto_8

  block ^if_else_6:
    jump ^if_end_7

  block ^if_end_7:
    jump ^goto_4

  block ^goto_4:
    store i32 3, $counted
    %t5 = load i32 $total
    %t6 = load i32 $counted
    %t7 = binary add i32 %t5, %t6
    store i32 %t7, $total
    jump ^goto_8

  block ^goto_8:
    store i32 5, $held
    %t8 = load i32 $total
    %t9 = load i32 $held
    %t10 = binary add i32 %t8, %t9
    store i32 %t10, $total
    jump ^goto_9

  block ^goto_9:
    store i32 1, $rounds
    %t11 = load i32 $total
    %t12 = load i32 $rounds
    %t13 = binary add i32 %t11, %t12
    store i32 %t13, $total
    %t14 = load i32 $total
    %t15 = cmp lt i32 %t14, 10
    branch %t15, ^if_then_10, ^if_else_11

  block ^if_then_10:
    jump ^goto_9

  block ^if_else_11:
    jump ^if_end_12

  block ^if_end_12:
    %t16 = load i32 $total
    return i32 %t16
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64

  block ^entry:
    %t1 = call i32 @run(0)
    %t2 = cmp eq i32 %t1, 10
    branch %t2, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t3 = call i32 @run(1)
    %t4 = cmp eq i32 %t3, 10
    %t5 = cmp ne i64 %t4, 0
    store i64 %t5, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t6 = load i64 $land__3
    branch %t6, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t7 = call i32 @run(2)
    %t8 = cmp eq i32 %t7, 10
    %t9 = cmp ne i64 %t8, 0
    store i64 %t9, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t10 = load i64 $land__2
    branch %t10, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t11 = load i32 $cond__1
    return i32 %t11
}
