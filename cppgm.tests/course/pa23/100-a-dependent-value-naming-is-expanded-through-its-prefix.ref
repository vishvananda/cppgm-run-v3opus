    %t4 = load i32 $one
    %t5 = load i32 $two
    %t6 = binary add i32 %t4, %t5
    %t7 = load i32 $three
    %t8 = binary add i32 %t6, %t7
    %t9 = load i32 $four
    %t10 = binary add i32 %t8, %t9
    %t11 = load i32 $five
    %t12 = binary add i32 %t10, %t11
    %t13 = binary sub i32 %t12, 3
    %t14 = binary sub i32 %t13, 3
    %t15 = binary sub i32 %t14, 2
    %t16 = binary sub i32 %t15, 8
    %t17 = binary sub i32 %t16, 2
    return i32 %t17
}
function @outer_int___counted(%__param0 : ptr) -> i32 [binding=weak, object=_ZN5outerIiE7countedIJclEEEiP4listIJXspsr6pairedIiT_EE5valueEEE] {
  slot $__param0 : ptr

