function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $found : i32
  slot $refused : i32
  slot $one_class_in : i32
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64

  block ^entry:
    %t1 = binary add i32 1, 1
    %t2 = binary add i32 %t1, 1
    %t3 = binary add i32 %t2, 1
    %t4 = binary add i32 %t3, 1
    store i32 %t4, $found
    %t5 = binary add i32 2, 2
    store i32 %t5, $refused
    store i32 1, $one_class_in
    %t6 = load i32 $found
    %t7 = cmp eq i32 %t6, 5
    branch %t7, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t8 = load i32 $refused
    %t9 = cmp eq i32 %t8, 4
    %t10 = cmp ne i64 %t9, 0
    store i64 %t10, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t11 = load i64 $land__4
    branch %t11, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t12 = load i32 $one_class_in
    %t13 = cmp eq i32 %t12, 1
    %t14 = cmp ne i64 %t13, 0
    store i64 %t14, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t15 = load i64 $land__3
    branch %t15, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t16 = call i32 @asked_in_a_function()
    %t17 = cmp eq i32 %t16, 2
    %t18 = cmp ne i64 %t17, 0
    store i64 %t18, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t19 = load i64 $land__2
    branch %t19, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t20 = load i32 $cond__1
    return i32 %t20
}
function @asked_in_a_function() -> i32 [binding=weak, object=_Z19asked_in_a_functionIvEiv] {
  block ^entry:
    %t1 = binary add i32 1, 1
    return i32 %t1
}
