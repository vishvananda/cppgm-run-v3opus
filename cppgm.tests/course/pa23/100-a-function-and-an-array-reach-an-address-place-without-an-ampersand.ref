global @digits [binding=strong, object=_Z6digits] = {
  i32 4
  i32 5
  i32 6
}

function @twice(%value : i32) -> i32 [binding=strong, object=_Z5twicei] {
  slot $value : i32

  block ^entry:
    store i32 %value, $value
    %t1 = load i32 $value
    %t2 = binary mul i32 %t1, 2
    return i32 %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64

  block ^entry:
    %t1 = call i32 @first_digits___read()
    %t2 = cmp eq i32 %t1, 4
    branch %t2, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t3 = call i32 @applied_twice___run(8)
    %t4 = cmp eq i32 %t3, 16
    %t5 = cmp ne i64 %t4, 0
    store i64 %t5, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t6 = load i64 $land__3
    branch %t6, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t7 = call i32 @third_digits___read()
    %t8 = cmp eq i32 %t7, 6
    %t9 = cmp ne i64 %t8, 0
    store i64 %t9, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t10 = load i64 $land__2
    branch %t10, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t11 = load i32 $cond__1
    return i32 %t11
}
function @first_digits___read() -> i32 [binding=weak, object=_ZN5firstIXadL_Z6digitsEEE4readEv] {
  block ^entry:
    %t1 = addr @digits
    %t2 = index i32 [projection=array_element] %t1, 0
    %t3 = load i32 %t2
    return i32 %t3
}
function @applied_twice___run(%value : i32) -> i32 [binding=weak, object=_ZN7appliedIXadL_Z5twiceiEEE3runEi] {
  slot $value : i32

  block ^entry:
    store i32 %value, $value
    %t1 = load i32 $value
    %t2 = addr @twice
    %t3 = unary decay ptr %t2
    %t4 = call i32 %t3(%t1) as (%arg0 : i32) -> i32
    return i32 %t4
}
function @third_digits___read() -> i32 [binding=weak, object=_ZN5thirdIL_Z6digitsEE4readEv] {
  block ^entry:
    %t1 = addr @digits
    %t2 = unary decay ptr %t1
    %t3 = index i32 [projection=array_element] %t2, 2
    %t4 = load i32 %t3
    return i32 %t4
}
