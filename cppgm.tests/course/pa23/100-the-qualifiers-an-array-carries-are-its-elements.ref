global @room [binding=strong, object=_Z4room] = {
  i32 1
  i32 2
  i32 3
}
global @held [binding=internal, object=_ZL4held] = {
  i32 4
  i32 5
  i32 6
}

function @first_of(%p : ptr) -> i32 [binding=strong, object=_Z8first_ofPA3_Ki] {
  slot $p : ptr

  block ^entry:
    store ptr %p, $p
    %t1 = load ptr $p
    %t2 = index i32 [projection=array_element] %t1, 0
    %t3 = load i32 %t2
    return i32 %t3
}
function @through_two(%p : ptr) -> i32 [binding=strong, object=_Z11through_twoPKPA3_Ki] {
  slot $p : ptr

  block ^entry:
    store ptr %p, $p
    %t1 = load ptr $p
    %t2 = load ptr %t1
    %t3 = index i32 [projection=array_element] %t2, 0
    %t4 = load i32 %t3
    return i32 %t4
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $added : ptr
  slot $shaken : ptr
  slot $both : ptr
  slot $rows : obj<24x4>
  slot $decayed : ptr
  slot $composite : ptr
  slot $cond__1 : ptr
  slot $plain : ptr
  slot $above : ptr
  slot $total : i32
  slot $cond__2 : i32

  block ^entry:
    %t1 = addr @room
    store ptr %t1, $added
    %t2 = addr @room
    store ptr %t2, $shaken
    %t3 = addr @room
    store ptr %t3, $both
    %t4 = addr $rows
    store i32 7, %t4
    %t5 = index i8 %t4, 4
    store i32 8, %t5
    %t6 = index i8 %t4, 8
    store i32 9, %t6
    %t7 = index i8 %t4, 12
    store i32 1, %t7
    %t8 = index i8 %t7, 4
    store i32 2, %t8
    %t9 = index i8 %t7, 8
    store i32 3, %t9
    %t10 = addr $rows
    %t11 = unary decay ptr %t10
    store ptr %t11, $decayed
    branch 1, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    %t12 = addr @room
    store ptr %t12, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    %t13 = addr @held
    store ptr %t13, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t14 = load ptr $cond__1
    store ptr %t14, $composite
    %t15 = addr @room
    store ptr %t15, $plain
    %t16 = addr $plain
    store ptr %t16, $above
    %t17 = load ptr $added
    %t18 = index i32 [projection=array_element] %t17, 0
    %t19 = load i32 %t18
    %t20 = load ptr $shaken
    %t21 = index i32 [projection=array_element] %t20, 1
    %t22 = load i32 %t21
    %t23 = binary add i32 %t19, %t22
    %t24 = load ptr $both
    %t25 = index i32 [projection=array_element] %t24, 2
    %t26 = load i32 %t25
    %t27 = binary add i32 %t23, %t26
    %t28 = load ptr $decayed
    %t29 = binary mul i64 1, 12
    %t30 = index i8 [projection=array_element] %t28, %t29
    %t31 = index i32 [projection=array_element] %t30, 0
    %t32 = load i32 %t31
    %t33 = binary add i32 %t27, %t32
    %t34 = load ptr $composite
    %t35 = index i32 [projection=array_element] %t34, 0
    %t36 = load i32 %t35
    %t37 = binary add i32 %t33, %t36
    %t38 = addr @room
    %t39 = call i32 @first_of(%t38)
    %t40 = binary add i32 %t37, %t39
    %t41 = addr @room
    %t42 = call i32 @deduced_first(%t41)
    %t43 = binary add i32 %t40, %t42
    %t44 = load ptr $above
    %t45 = call i32 @through_two(%t44)
    %t46 = binary add i32 %t43, %t45
    store i32 %t46, $total
    %t47 = load i32 $total
    %t48 = binary add i32 1, 2
    %t49 = binary add i32 %t48, 3
    %t50 = binary add i32 %t49, 1
    %t51 = binary add i32 %t50, 1
    %t52 = binary add i32 %t51, 1
    %t53 = binary add i32 %t52, 1
    %t54 = binary add i32 %t53, 1
    %t55 = cmp eq i32 %t47, %t54
    branch %t55, ^cond_then_4, ^cond_else_5

  block ^cond_then_4:
    store i32 0, $cond__2
    jump ^cond_end_6

  block ^cond_else_5:
    store i32 1, $cond__2
    jump ^cond_end_6

  block ^cond_end_6:
    %t56 = load i32 $cond__2
    return i32 %t56
}
function @deduced_first(%p : ptr) -> i32 [binding=weak, object=_Z13deduced_firstIiET_PA3_KS0_] {
  slot $p : ptr

  block ^entry:
