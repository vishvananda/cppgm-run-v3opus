function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $held : obj<1x1>
  slot $value : i64
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $held
    store i64 0, $value
    %t2 = addr $held
    %t3 = addr $value
    %t4 = call u8 @holder__pop(%t2, %t3)
    branch %t4, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t5 = load i32 $cond__1
    %t6 = addr $held
    %t7 = call i32 @holder__span(%t6)
    %t8 = binary add i32 %t5, %t7
    %t9 = addr $held
    %t10 = call i32 @holder__reach(%t9)
    %t11 = binary add i32 %t8, %t10
    return i32 %t11
}
function @holder__pop(%this : ptr, %value : ptr [pass=reference]) -> u8 [binding=weak, object=_ZN6holder3popERl] {
  slot $this : ptr
  slot $value : ptr

  block ^entry:
    store ptr %this, $this
    store ptr %value, $value
    %t1 = load ptr $this
    %t2 = load ptr $value
    %t3 = call u8 @holder__pop__ov2(%t1, %t2)
    return u8 %t3
}
function @holder__pop__ov2(%this : ptr, %__param1 : ptr [pass=reference]) -> u8 [binding=weak, object=_ZN6holder3popIlvEEbRT_] {
  slot $this : ptr
  slot $__param1 : ptr

  block ^entry:
    store ptr %this, $this
    store ptr %__param1, $__param1
    return u8 1
}
function @holder__reach(%this : ptr) -> i32 [binding=weak, object=_ZN6holder5reachEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    return i32 0
}
function @holder__span(%this : ptr) -> i32 [binding=weak, object=_ZN6holder4spanEv] {
  slot $this : ptr
  slot $measured : i32

  block ^entry:
    store ptr %this, $this
    store i32 0, $measured
    %t1 = load i32 $measured
    return i32 %t1
}
