global @counted : i32 [binding=strong, object=_Z7counted] = 3

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $risky : ptr

  block ^entry:
    jump ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    jump ^if_else_5

  block ^if_then_4:
    return i32 2

  block ^if_else_5:
    jump ^if_end_6

  block ^if_end_6:
    jump ^if_else_8

  block ^if_then_7:
    return i32 3

  block ^if_else_8:
    jump ^if_end_9

  block ^if_end_9:
    jump ^if_else_11

  block ^if_then_10:
    return i32 4

  block ^if_else_11:
    jump ^if_end_12

  block ^if_end_12:
    jump ^if_else_14

  block ^if_then_13:
    return i32 5

  block ^if_else_14:
    jump ^if_end_15

  block ^if_end_15:
    %t1 = cmp eq u8 1, 0
    branch %t1, ^if_then_16, ^if_else_17

  block ^if_then_16:
    return i32 6

  block ^if_else_17:
    jump ^if_end_18

  block ^if_end_18:
    %t2 = cmp eq u8 1, 0
    branch %t2, ^if_then_19, ^if_else_20

  block ^if_then_19:
    return i32 7

  block ^if_else_20:
    jump ^if_end_21

  block ^if_end_21:
    %t3 = addr @counted
    store ptr %t3, $risky
    %t4 = cmp eq u8 1, 0
    branch %t4, ^if_then_22, ^if_else_23

  block ^if_then_22:
    return i32 8

  block ^if_else_23:
    jump ^if_end_24

  block ^if_end_24:
    return i32 0
}
