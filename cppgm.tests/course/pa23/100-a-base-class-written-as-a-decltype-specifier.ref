function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = binary add i32 1, 2
    %t2 = binary add i32 %t1, 1
    %t3 = binary add i32 %t2, 1
    %t4 = binary add i32 %t3, 2
    %t5 = binary add i32 %t4, 2
    %t6 = binary add i32 %t5, 1
    %t7 = cmp eq i32 %t6, 10
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load i32 $cond__1
    return i32 %t8
}
