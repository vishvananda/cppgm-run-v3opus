    %t12 = binary add i32 %t9, %t11
    %t13 = addr $none
    %t14 = call i32 @reached(%t13)
    %t15 = binary add i32 %t12, %t14
    %t16 = binary sub i32 %t15, 4
    %t17 = binary sub i32 %t16, 2
    %t18 = binary sub i32 %t17, 44
    %t19 = binary sub i32 %t18, 8
    %t20 = binary sub i32 %t19, 3
    return i32 %t20
}
