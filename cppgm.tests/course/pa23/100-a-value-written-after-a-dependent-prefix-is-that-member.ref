function @reached() -> i32 [arity=variadic, binding=strong, object=_Z7reachedz] {
  block ^entry:
    return i32 2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $one : obj<1x1>
  slot $none : obj<1x1>

  block ^entry:
    %t1 = addr $one
    %t2 = addr $none
    %t3 = call i32 @chosen()
    %t4 = call i32 @counted()
    %t5 = binary add i32 %t3, %t4
    %t6 = call i32 @truncated()
    %t7 = binary add i32 %t5, %t6
    %t8 = call i32 @twice()
    %t9 = binary add i32 %t7, %t8
