function @run(%selector : i32) -> i32 [binding=strong, object=_Z3runi] {
  slot $selector : i32
  slot $outer : i32
  slot $settled : i32
  slot $closed : i32
  slot $scalar : i32
  slot $elements : obj<8x4>
  slot $trivial : obj<8x4>

  block ^entry:
    store i32 %selector, $selector
    store i32 4, $outer
    %t1 = load i32 $selector
    store i32 %t1, $settled
    %t2 = load i32 $settled
    jump ^switch_dispatch_1

  block ^switch_dispatch_1:
    switch %t2, ^switch_default_4, 0:^switch_case_3

  block ^switch_case_3:
    store i32 8, $closed
    %t3 = load i32 $outer
    %t4 = load i32 $closed
    %t5 = binary add i32 %t3, %t4
    %t6 = binary sub i32 %t5, 8
    store i32 %t6, $outer
    %t7 = addr $trivial
    %t8 = load i32 $outer
    store i32 %t8, $scalar
    %t9 = addr $elements
    %t10 = unary decay ptr %t9
    %t11 = index i32 [projection=array_element] %t10, 0
    store i32 1, %t11
    %t12 = addr $trivial
    %t13 = index i8 [projection=field] %t12, 0
    store i32 2, %t13
    %t14 = load i32 $scalar
    %t15 = addr $elements
    %t16 = unary decay ptr %t15
    %t17 = index i32 [projection=array_element] %t16, 0
    %t18 = load i32 %t17
    %t19 = binary add i32 %t14, %t18
    %t20 = addr $trivial
    %t21 = index i8 [projection=field] %t20, 0
    %t22 = load i32 %t21
    %t23 = binary add i32 %t19, %t22
    return i32 %t23

  block ^switch_default_4:
    %t24 = load i32 $outer
    %t25 = load i32 $settled
    %t26 = binary add i32 %t24, %t25
    return i32 %t26

  block ^switch_end_2:
    return i32 0
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = call i32 @run(0)
    %t2 = cmp eq i32 %t1, 7
    branch %t2, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t3 = call i32 @run(1)
    %t4 = cmp eq i32 %t3, 5
    %t5 = cmp ne i64 %t4, 0
    store i64 %t5, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t6 = load i64 $land__2
    branch %t6, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t7 = load i32 $cond__1
    return i32 %t7
}
