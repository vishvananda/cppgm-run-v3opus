global @dynamic_extent : i64 [binding=internal, object=_ZL14dynamic_extent] = -1
global @extents [binding=strong, object=_Z7extents] = {
  i64 1
  i64 18446744073709551615
  i64 2
}
global @written [binding=strong, object=_Z7written] = {
  i64 18446744073709551615
  i64 -2
  u32 4294967295
  zero 4
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64

  block ^entry:
    %t1 = addr @extents
    %t2 = unary decay ptr %t1
    %t3 = index i64 [projection=array_element] %t2, 1
    %t4 = load i64 %t3
    %t5 = load i64 @dynamic_extent
    %t6 = cmp eq i64 %t4, %t5
    branch %t6, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t7 = addr @written
    %t8 = index i8 [projection=field] %t7, 0
    %t9 = load i64 %t8
    %t10 = load i64 @dynamic_extent
    %t11 = cmp eq i64 %t9, %t10
    %t12 = cmp ne i64 %t11, 0
    store i64 %t12, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t13 = load i64 $land__4
    branch %t13, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t14 = addr @written
    %t15 = index i8 [projection=field] %t14, 8
    %t16 = load i64 %t15
    %t17 = unary neg i32 2
    %t18 = convert sext i64 i32 %t17
    %t19 = cmp eq i64 %t16, %t18
    %t20 = cmp ne i64 %t19, 0
    store i64 %t20, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t21 = load i64 $land__3
    branch %t21, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t22 = addr @written
    %t23 = index i8 [projection=field] %t22, 16
    %t24 = load u32 %t23
    %t25 = cmp eq u32 %t24, 4294967295
    %t26 = cmp ne i64 %t25, 0
    store i64 %t26, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t27 = load i64 $land__2
    branch %t27, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t28 = load i32 $cond__1
    return i32 %t28
}
