function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $i : i32
  slot $o : obj<1x1>
  slot $h : obj<1x1>

  block ^entry:
    store i32 0, $i
    %t1 = addr $i
    call void @take(%t1)
    call void @give(1)
    %t2 = addr $i
    call void @run__ov2(%t2)
    %t3 = addr $o
    %t4 = addr $o
    call void @outer__mm(%t4, 1)
    %t5 = addr $h
    %t6 = addr $h
    call void @holder_int___m(%t6, 1)
    %t7 = const i64 1
    %t8 = convert sext i64 i32 1
    %t9 = cmp ne i64 %t7, %t8
    branch %t9, ^if_then_1, ^lor_rhs_4

  block ^lor_rhs_4:
    %t10 = const i64 1
    %t11 = convert sext i64 i32 1
    %t12 = cmp ne i64 %t10, %t11
    branch %t12, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 2

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t13 = addr $h
    %t14 = call i32 @holder_int___n(%t13, 0)
    %t15 = binary sub i32 %t14, 4
    return i32 %t15
}
function @take(%p : ptr) -> void [binding=weak, object=_Z4takeIiEvPv] {
  slot $p : ptr

  block ^entry:
    store ptr %p, $p
    return void
}
function @give(%x : i32) -> void [binding=weak, object=_Z4giveIiEvT_] {
  slot $x : i32

  block ^entry:
    store i32 %x, $x
    return void
}
function @run__ov2(%p : ptr) -> void [binding=weak, object=_Z3runIJicEEvPv] {
  slot $p : ptr

  block ^entry:
    store ptr %p, $p
    return void
}
function @outer__mm(%this : ptr, %x : i32) -> void [binding=weak, object=_ZN5outer2mmIiEEvT_] {
  slot $this : ptr
  slot $x : i32

  block ^entry:
    store ptr %this, $this
    store i32 %x, $x
    return void
}
function @holder_int___m(%this : ptr, %x : i32) -> void [binding=weak, object=_ZN6holderIiE1mEi] {
  slot $this : ptr
  slot $x : i32

  block ^entry:
    store ptr %this, $this
    store i32 %x, $x
    return void
}
function @holder_int___n(%this : ptr, %p : ptr) -> i32 [binding=weak, object=_ZN6holderIiE1nEPv] {
  slot $this : ptr
  slot $p : ptr

  block ^entry:
    store ptr %this, $this
    store ptr %p, $p
    return i32 4
}
