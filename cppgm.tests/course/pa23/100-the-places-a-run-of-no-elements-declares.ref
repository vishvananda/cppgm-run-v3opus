}
function @parenthesized__parenthesized(%this : ptr) -> void [binding=weak, object=_ZN13parenthesizedC1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load ptr $this
    %t2 = index i8 [projection=field] %t1, 0
    store i32 0, %t2
    return void
}
function @counted__counted(%this : ptr) -> void [binding=weak, object=_ZN7countedC1Ev] {
  slot $this : ptr

  block ^entry:
