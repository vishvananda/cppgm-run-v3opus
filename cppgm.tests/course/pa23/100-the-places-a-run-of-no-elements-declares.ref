function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $first : obj<4x4>
  slot $second : obj<4x4>
  slot $third : obj<4x4>
  slot $fourth : obj<4x4>

  block ^entry:
    %t1 = addr $first
    call void @parenthesized__parenthesized(%t1)
    %t2 = addr $second
    call void @parenthesized__parenthesized(%t2)
    %t3 = addr $third
    call void @counted__counted(%t3)
    %t4 = addr $fourth
    call void @counted__counted(%t4)
    %t5 = addr $first
    %t6 = index i8 [projection=field] %t5, 0
    %t7 = index i8 [projection=field] %t6, 0
    %t8 = load i32 %t7
