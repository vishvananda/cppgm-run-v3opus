global @held : ptr [binding=strong, object=_Z4held] = 0
global @counter : i32 [binding=strong, object=_Z7counter] = 0

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : i32
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = call i32 @ignored__counter___read()
    store i32 %t1, $value
    %t2 = load i32 $value
    %t3 = cmp eq i32 %t2, 11
    branch %t3, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t4 = load ptr @held
    %t5 = cmp eq ptr %t4, 0
    %t6 = cmp ne i64 %t5, 0
    store i64 %t6, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t7 = load i64 $land__2
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load i32 $cond__1
    return i32 %t8
}
function @ignored__counter___read() -> i32 [binding=weak, object=_ZN7ignoredIXadL_Z7counterEEE4readEv] {
  block ^entry:
    return i32 11
}
