  block ^land_rhs_8:
    %t18 = addr $kept
    %t19 = addr $k
    %t20 = call i32 @derived_kept__kept(%t18, %t19)
    %t21 = cmp eq i32 %t20, 2
    %t22 = cmp ne i64 %t21, 0
    store i64 %t22, $land__2
    jump ^land_end_10

  block ^land_short_9:
    store i64 0, $land__2
    jump ^land_end_10

  block ^land_end_10:
    %t23 = load i64 $land__2
    branch %t23, ^cond_then_5, ^cond_else_6

  block ^cond_then_5:
    store i32 0, $cond__1
    jump ^cond_end_7

  block ^cond_else_6:
    store i32 1, $cond__1
