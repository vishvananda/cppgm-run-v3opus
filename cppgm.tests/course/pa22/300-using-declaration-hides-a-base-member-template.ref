    %t7 = call i32 @derived_below__pick(%t5, %t6)
    %t8 = cmp ne i32 %t7, 2
    branch %t8, ^if_then_1, ^lor_rhs_4

  block ^lor_rhs_4:
    %t9 = addr $above
