    %t11 = call i32 @derived_above__also(%t9, %t10)
    %t12 = cmp ne i32 %t11, 2
    branch %t12, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t13 = addr $kept
    %t14 = index i8 [projection=base_subobject] %t13, 0
    %t15 = addr $k
    %t16 = call i32 @base__kept(%t14, %t15)
    %t17 = cmp eq i32 %t16, 1
