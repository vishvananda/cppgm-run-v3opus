function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $c : obj<1x1>
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = addr $c
    %t2 = addr $c
    %t3 = call i32 @counter_int___advance(%t2, 1)
    %t4 = cmp eq i32 %t3, 4
    branch %t4, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t5 = addr $c
    %t6 = call i32 @counter_int___advance__ov2(%t5, 1)
    %t7 = cmp eq i32 %t6, 7
    %t8 = cmp ne i64 %t7, 0
    store i64 %t8, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t9 = load i64 $land__2
    branch %t9, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t10 = load i32 $cond__1
    return i32 %t10
}
function @counter_int___advance(%this : ptr, %x : i32) -> i32 [binding=weak, object=_ZNK7counterIiE7advanceIiLi3ELb0EEEiT_] {
  slot $this : ptr
  slot $x : i32
  slot $cond__1 : i32

  block ^entry:
    store ptr %this, $this
    store i32 %x, $x
    %t1 = load i32 $x
    branch 0, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    %t2 = binary add i32 3, 3
    store i32 %t2, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 3, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load i32 $cond__1
    %t4 = binary add i32 %t1, %t3
    return i32 %t4
}
function @counter_int___advance__ov2(%this : ptr, %x : i32) -> i32 [binding=weak, object=_ZNK7counterIiE7advanceIiLi3ELb1EEEiT_] {
  slot $this : ptr
  slot $x : i32
