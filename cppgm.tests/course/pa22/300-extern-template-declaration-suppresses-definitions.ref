declare global @holder_int___count : i32 [binding=strong, object=_ZN6holderIiE5countE]
declare function @twice(%arg0 : i32) -> i32 [binding=strong, object=_Z5twiceIiET_S0_]
declare function @holder_int___outside(%arg0 : ptr) -> i32 [binding=weak, object=_ZN6holderIiE7outsideEv]

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $one : obj<1x1>

  block ^entry:
    %t1 = addr $one
    %t2 = call i32 @twice(0)
    %t3 = addr $one
    %t4 = call i32 @holder_int___inside(%t3)
    %t5 = binary add i32 %t2, %t4
    %t6 = addr $one
    %t7 = call i32 @holder_int___outside(%t6)
    %t8 = binary add i32 %t5, %t7
    %t9 = load i32 @holder_int___count
    %t10 = binary add i32 %t8, %t9
    %t11 = binary sub i32 %t10, 6
    return i32 %t11
}
function @holder_int___inside(%this : ptr) -> i32 [binding=weak, object=_ZN6holderIiE6insideEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    return i32 1
}
