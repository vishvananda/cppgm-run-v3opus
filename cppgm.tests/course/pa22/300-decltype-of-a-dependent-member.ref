global @thing__count : i32 [binding=strong, object=_ZN5thing5countE] = 3
global @thing__inner__wide : i64 [binding=strong, object=_ZN5thing5inner4wideE] = 4
global @box_thing___held : i32 [binding=weak, object=_ZN3boxI5thingE4heldE] = zero

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $wide : i64
  slot $bound : ptr
  slot $counted : i32
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64
  slot $land__5 : i64
  slot $land__6 : i64

  block ^entry:
    store i32 5, @box_thing___held
    store i64 6, $wide
    %t1 = addr @thing__count
    store ptr %t1, $bound
    store i32 2, $counted
    %t2 = load i32 @box_thing___held
    %t3 = cmp eq i32 %t2, 5
    branch %t3, ^land_rhs_16, ^land_short_17

  block ^land_rhs_16:
    %t4 = load i64 $wide
    %t5 = cmp eq i64 %t4, 6
    %t6 = cmp ne i64 %t5, 0
    store i64 %t6, $land__6
    jump ^land_end_18

  block ^land_short_17:
    store i64 0, $land__6
    jump ^land_end_18

  block ^land_end_18:
    %t7 = load i64 $land__6
    branch %t7, ^land_rhs_13, ^land_short_14

  block ^land_rhs_13:
    %t8 = load ptr $bound
    %t9 = load i32 %t8
    %t10 = cmp eq i32 %t9, 3
    %t11 = cmp ne i64 %t10, 0
    store i64 %t11, $land__5
    jump ^land_end_15

  block ^land_short_14:
    store i64 0, $land__5
    jump ^land_end_15

  block ^land_end_15:
    %t12 = load i64 $land__5
    branch %t12, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t13 = call i32 @box_thing___doubled()
    %t14 = cmp eq i32 %t13, 6
    %t15 = cmp ne i64 %t14, 0
    store i64 %t15, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t16 = load i64 $land__4
    branch %t16, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t17 = call i32 @box_thing___taking(7)
    %t18 = cmp eq i32 %t17, 7
    %t19 = cmp ne i64 %t18, 0
    store i64 %t19, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t20 = load i64 $land__3
    branch %t20, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t21 = load i32 $counted
    %t22 = cmp eq i32 %t21, 2
    %t23 = cmp ne i64 %t22, 0
    store i64 %t23, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t24 = load i64 $land__2
    branch %t24, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t25 = load i32 $cond__1
    return i32 %t25
}
function @box_thing___doubled() -> i32 [binding=weak, object=_ZN3boxI5thingE7doubledEv] {
  block ^entry:
    %t1 = load i32 @thing__count
    %t2 = binary mul i32 %t1, 2
    return i32 %t2
}
function @box_thing___taking(%v : i32) -> i32 [binding=weak, object=_ZN3boxI5thingE6takingEi] {
  slot $v : i32

  block ^entry:
    store i32 %v, $v
    %t1 = load i32 $v
    return i32 %t1
}
