function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $total : i64
  slot $cond__1 : i32

  block ^entry:
    %t1 = convert sext i64 i32 0
    store i64 %t1, $total
    %t2 = load i64 $total
    %t3 = binary add i64 %t2, 3
    store i64 %t3, $total
    %t4 = load i64 $total
    %t5 = binary add i64 %t4, 6
    store i64 %t5, $total
    %t6 = load i64 $total
    %t7 = binary add i64 %t6, 3
    store i64 %t7, $total
    %t8 = load i64 $total
    %t9 = binary add i64 %t8, 3
    store i64 %t9, $total
    %t10 = load i64 $total
    %t11 = binary add i64 %t10, 3
    store i64 %t11, $total
    %t12 = load i64 $total
    %t13 = binary add i64 %t12, 12
    store i64 %t13, $total
    %t14 = load i64 $total
    %t15 = binary add i32 3, 6
    %t16 = binary add i32 %t15, 3
    %t17 = binary add i32 %t16, 3
    %t18 = binary add i32 %t17, 3
    %t19 = binary add i32 %t18, 12
    %t20 = convert sext i64 i32 %t19
    %t21 = cmp eq i64 %t14, %t20
    branch %t21, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t22 = load i32 $cond__1
    return i32 %t22
}
