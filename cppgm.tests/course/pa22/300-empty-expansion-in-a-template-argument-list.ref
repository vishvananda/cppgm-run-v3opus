function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $held : obj<4x4>

  block ^entry:
    %t1 = addr $held
    %t2 = addr $held
    %t3 = index i8 [projection=field] %t2, 0
    store i32 4, %t3
    %t4 = addr $held
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = load i32 %t5
    %t7 = cmp ne i32 %t6, 4
    branch %t7, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t8 = cmp ne i32 1, 1
    branch %t8, ^if_then_4, ^if_else_5

  block ^if_then_4:
    return i32 2

  block ^if_else_5:
    jump ^if_end_6

  block ^if_end_6:
    %t9 = cmp eq u8 1, 0
    branch %t9, ^if_then_7, ^if_else_8

  block ^if_then_7:
    return i32 3

  block ^if_else_8:
    jump ^if_end_9

  block ^if_end_9:
    return i32 0
}
