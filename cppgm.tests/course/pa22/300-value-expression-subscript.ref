function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64
  slot $land__5 : i64
  slot $land__6 : i64
  slot $land__7 : i64
  slot $land__8 : i64
  slot $land__9 : i64
  slot $land__10 : i64

  block ^entry:
    %t1 = cmp eq i64 53, 53
    branch %t1, ^land_rhs_28, ^land_short_29

  block ^land_rhs_28:
    %t2 = cmp eq i64 6, 6
    %t3 = cmp ne i64 %t2, 0
    store i64 %t3, $land__10
    jump ^land_end_30

  block ^land_short_29:
    store i64 0, $land__10
    jump ^land_end_30

  block ^land_end_30:
    %t4 = load i64 $land__10
    branch %t4, ^land_rhs_25, ^land_short_26

  block ^land_rhs_25:
    %t5 = convert sext i64 i8 99
    %t6 = cmp eq i64 99, %t5
    %t7 = cmp ne i64 %t6, 0
    store i64 %t7, $land__9
    jump ^land_end_27

  block ^land_short_26:
    store i64 0, $land__9
    jump ^land_end_27

  block ^land_end_27:
    %t8 = load i64 $land__9
    branch %t8, ^land_rhs_22, ^land_short_23

  block ^land_rhs_22:
    %t9 = convert sext i64 i8 100
    %t10 = cmp eq i64 100, %t9
    %t11 = cmp ne i64 %t10, 0
    store i64 %t11, $land__8
    jump ^land_end_24

  block ^land_short_23:
    store i64 0, $land__8
    jump ^land_end_24

  block ^land_end_24:
    %t12 = load i64 $land__8
    branch %t12, ^land_rhs_19, ^land_short_20

  block ^land_rhs_19:
    %t13 = cmp eq i64 29, 29
    %t14 = cmp ne i64 %t13, 0
    store i64 %t14, $land__7
    jump ^land_end_21

  block ^land_short_20:
    store i64 0, $land__7
    jump ^land_end_21

  block ^land_end_21:
    %t15 = load i64 $land__7
    branch %t15, ^land_rhs_16, ^land_short_17

  block ^land_rhs_16:
    %t16 = cmp eq i64 30, 30
    %t17 = cmp ne i64 %t16, 0
    store i64 %t17, $land__6
    jump ^land_end_18

  block ^land_short_17:
    store i64 0, $land__6
    jump ^land_end_18

  block ^land_end_18:
    %t18 = load i64 $land__6
    branch %t18, ^land_rhs_13, ^land_short_14

  block ^land_rhs_13:
    %t19 = cmp eq i64 5, 5
    %t20 = cmp ne i64 %t19, 0
    store i64 %t20, $land__5
    jump ^land_end_15

  block ^land_short_14:
    store i64 0, $land__5
    jump ^land_end_15

  block ^land_end_15:
    %t21 = load i64 $land__5
    branch %t21, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t22 = cmp eq i64 8, 8
    %t23 = cmp ne i64 %t22, 0
    store i64 %t23, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t24 = load i64 $land__4
    branch %t24, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t25 = cmp eq i64 13, 13
    %t26 = cmp ne i64 %t25, 0
    store i64 %t26, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t27 = load i64 $land__3
    branch %t27, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t28 = cmp eq i64 53, 53
    %t29 = cmp ne i64 %t28, 0
    store i64 %t29, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t30 = load i64 $land__2
    branch %t30, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t31 = load i32 $cond__1
    return i32 %t31
}
