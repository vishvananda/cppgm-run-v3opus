function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $node : obj<8x8>
  slot $plain : obj<8x4>

  block ^entry:
    %t1 = addr $node
    call void @Node_Value___Node(%t1)
    %t2 = addr $plain
    call void @Plain__Plain(%t2)
    %t3 = addr $node
    %t4 = addr $plain
    %t5 = index i8 [projection=field] %t4, 4
    %t6 = load i32 %t5
    %t7 = binary sub i32 %t6, 3
    return i32 %t7
}
function @Node_Value___Node(%this : ptr) -> void [binding=weak, object=_ZN4NodeI5ValueEC1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    return void
}
function @Plain__Plain(%this : ptr) -> void [binding=weak, object=_ZN5PlainC1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load ptr $this
    %t2 = index i8 [projection=field] %t1, 4
    store i32 3, %t2
    return void
}
alias object _ZN4NodeI5ValueEC2Ev = @Node_Value___Node
alias object _ZN5PlainC2Ev = @Plain__Plain
