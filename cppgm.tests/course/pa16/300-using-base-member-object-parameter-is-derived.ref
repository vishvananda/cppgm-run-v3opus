function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $d : obj<1x1>
  slot $c : ptr

  block ^entry:
    %t1 = addr $d
    %t2 = addr $d
    store ptr %t2, $c
    %t3 = addr $d
    %t4 = index i8 [projection=base_subobject] %t3, 0
    %t5 = call i32 @base_object_parameter__f(%t4)
    %t6 = load ptr $c
    %t7 = call i32 @derived_object_parameter__f(%t6)
    %t8 = binary add i32 %t5, %t7
    %t9 = binary sub i32 %t8, 3
    return i32 %t9
}
function @base_object_parameter__f(%this : ptr) -> i32 [binding=weak, object=_ZN21base_object_parameter1fEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    return i32 1
}
function @derived_object_parameter__f(%this : ptr) -> i32 [binding=weak, object=_ZNK24derived_object_parameter1fEv] {
  slot $this : ptr

