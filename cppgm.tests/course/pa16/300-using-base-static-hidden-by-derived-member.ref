function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $derived : obj<1x1>

  block ^entry:
    %t1 = addr $derived
    %t2 = addr $derived
    %t3 = call i32 @static_list_derived__shared(%t2, 1)
    %t4 = call i32 @static_list_derived__only_here(2)
    %t5 = binary add i32 %t3, %t4
    %t6 = binary sub i32 %t5, 33
    return i32 %t6
}
function @static_list_derived__only_here(%given : i32) -> i32 [binding=weak, object=_ZN19static_list_derived9only_hereEi] {
  slot $given : i32

  block ^entry:
    store i32 %given, $given
    %t1 = load i32 $given
    %t2 = binary add i32 %t1, 20
    return i32 %t2
}
function @static_list_derived__shared(%this : ptr, %given : i32) -> i32 [binding=weak, object=_ZN19static_list_derived6sharedEi] {
  slot $this : ptr
  slot $given : i32

  block ^entry:
    store ptr %this, $this
    store i32 %given, $given
    %t1 = load i32 $given
    %t2 = binary add i32 %t1, 10
    return i32 %t2
}
