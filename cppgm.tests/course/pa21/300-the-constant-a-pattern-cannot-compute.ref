function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = const i64 1
    %t2 = const i64 1
    %t3 = binary add i64 %t1, %t2
    %t4 = const i64 1
    %t5 = binary add i64 %t3, %t4
    %t6 = const i64 1
    %t7 = binary add i64 %t5, %t6
    %t8 = const i64 1
    %t9 = binary add i64 %t7, %t8
    %t10 = convert sext i64 i32 5
    %t11 = cmp eq i64 %t9, %t10
    branch %t11, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t12 = load i32 $cond__1
    return i32 %t12
}
