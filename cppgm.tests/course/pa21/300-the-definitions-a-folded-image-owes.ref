function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64

  block ^entry:
    %t1 = addr @folded
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load i32 %t2
    %t4 = cmp eq i32 %t3, 0
    branch %t4, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t5 = addr @blank
    %t6 = index i8 [projection=field] %t5, 0
    %t7 = load i32 %t6
    %t8 = cmp eq i32 %t7, 0
    %t9 = cmp ne i64 %t8, 0
    store i64 %t9, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t10 = load i64 $land__4
    branch %t10, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t11 = addr @built
    %t12 = index i8 [projection=field] %t11, 4
    %t13 = load i32 %t12
    %t14 = cmp eq i32 %t13, 5
    %t15 = cmp ne i64 %t14, 0
    store i64 %t15, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t16 = load i64 $land__3
    branch %t16, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t17 = addr @spare
    %t18 = index i8 [projection=field] %t17, 0
    %t19 = load i32 %t18
    %t20 = addr @row
    %t21 = unary decay ptr %t20
    %t22 = binary mul i64 2, 4
    %t23 = index i8 [projection=array_element] %t21, %t22
    %t24 = index i8 [projection=field] %t23, 0
    %t25 = load i32 %t24
    %t26 = addr @slot
    %t27 = index i8 [projection=field] %t26, 0
    %t28 = load i32 %t27
    %t29 = binary add i32 %t25, %t28
    %t30 = cmp eq i32 %t19, %t29
    %t31 = cmp ne i64 %t30, 0
    store i64 %t31, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t32 = load i64 $land__2
    branch %t32, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t33 = load i32 $cond__1
    return i32 %t33
}
function @read_by_fold__read_by_fold(%this : ptr) -> void [unwind=no, binding=weak, object=_ZN12read_by_foldC1Ev, trivial_lifecycle=yes] {
  slot $this : ptr

  block ^entry:
