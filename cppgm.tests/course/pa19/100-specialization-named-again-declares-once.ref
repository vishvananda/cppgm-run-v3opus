function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $a
    %t2 = addr $a
    %t3 = index i8 [projection=field] %t2, 0
    store i32 13, %t3
    %t4 = addr $a
    %t5 = call i32 @holder_box___scaled(%t4)
    %t6 = cmp eq i32 %t5, 39
    branch %t6, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t7 = load i32 $cond__1
    return i32 %t7
}
function @holder_box___scaled(%this : ptr) -> i32 [binding=weak, object=_ZN6holderI3boxE6scaledEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load ptr $this
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load i32 %t2
    %t4 = binary mul i32 %t3, 3
    return i32 %t4
}
