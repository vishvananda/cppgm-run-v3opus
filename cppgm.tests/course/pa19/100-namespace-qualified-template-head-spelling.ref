function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $both : obj<8x4>

  block ^entry:
    %t1 = addr $both
    %t2 = addr $both
    %t3 = index i8 [projection=field] %t2, 0
    store i32 40, %t3
    %t4 = addr $both
    %t5 = index i8 [projection=field] %t4, 4
    store i8 2, %t5
    %t6 = addr $both
    %t7 = call i32 @outer__store__pair_int__char___total(%t6)
    %t8 = binary sub i32 %t7, 42
    return i32 %t8
}
function @outer__store__pair_int__char___total(%this : ptr) -> i32 [binding=weak, object=_ZNK5outer5store4pairIicE5totalEv] {
  slot $this : ptr

  block ^entry:
