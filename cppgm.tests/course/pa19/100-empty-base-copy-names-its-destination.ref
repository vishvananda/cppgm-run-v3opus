  slot $second : obj<4x4>

  block ^entry:
    %t1 = addr $first
    call void @Counted__Counted(%t1, 3)
    %t2 = addr $second
    %t3 = addr $first
    call void @Counted__Counted__ov2(%t2, %t3)
    %t4 = addr $second
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = load i32 %t5
    %t7 = binary sub i32 %t6, 4
    return i32 %t7
}
