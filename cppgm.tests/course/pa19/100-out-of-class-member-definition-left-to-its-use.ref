global @side : i32 [binding=strong, object=_Z4side] = zero

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $one : obj<4x4>

  block ^entry:
    %t1 = addr $one
    %t2 = addr $one
    %t3 = index i8 [projection=field] %t2, 0
    store i32 3, %t3
    %t4 = addr $one
    %t5 = call i32 @holder_int___taken(%t4)
    store i32 %t5, @side
    %t6 = load i32 @side
    return i32 %t6
}
function @holder_int___taken(%this : ptr) -> i32 [binding=weak, object=_ZN6holderIiE5takenEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load ptr $this
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load i32 %t2
    %t4 = load ptr $this
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = load i32 %t5
    %t7 = binary add i32 %t3, %t6
    return i32 %t7
}
