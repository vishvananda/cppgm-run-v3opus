function @cast_only(%p : ptr) -> i32 [binding=strong, object=_Z9cast_onlyPv] {
  slot $p : ptr
  slot $cond__1 : i32

  block ^entry:
    store ptr %p, $p
    %t1 = load ptr $p
    %t2 = cmp eq ptr %t1, 0
    branch %t2, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t3 = load i32 $cond__1
    return i32 %t3
}
function @size_only() -> i32 [binding=strong, object=_Z9size_onlyv] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = const i64 8
    %t2 = const i64 8
    %t3 = cmp eq i64 %t1, %t2
