}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $a
    %t2 = addr $a
    %t3 = index i8 [projection=field] %t2, 0
    store i32 13, %t3
    %t4 = addr $a
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = load i32 %t5
    %t7 = binary mul i32 %t6, 3
    %t8 = cmp eq i32 %t7, 39
    branch %t8, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
