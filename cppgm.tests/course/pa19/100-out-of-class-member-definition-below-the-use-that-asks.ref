function @holder_char___doubled(%this : ptr) -> i32 [binding=weak, object=_ZN6holderIcE7doubledEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load ptr $this
    %t2 = call i32 @holder_char___quadrupled(%t1)
    %t3 = binary div i32 %t2, 2
    return i32 %t3
