function @above() -> i32 [binding=strong, object=_Z5abovev] {
  slot $early : obj<4x4>

  block ^entry:
    %t1 = addr $early
    %t2 = addr $early
    %t3 = index i8 [projection=field] %t2, 0
    store i32 2, %t3
    %t4 = addr $early
    %t5 = call i32 @holder_int___doubled(%t4)
    return i32 %t5
}
function @below() -> i32 [binding=strong, object=_Z5belowv] {
  slot $late : obj<1x1>

  block ^entry:
    %t1 = addr $late
    %t2 = addr $late
    %t3 = index i8 [projection=field] %t2, 0
    store i8 3, %t3
    %t4 = addr $late
    %t5 = call i32 @holder_char___doubled(%t4)
    return i32 %t5
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @above()
    %t2 = call i32 @below()
    %t3 = binary add i32 %t1, %t2
    return i32 %t3
}
function @holder_int___doubled(%this : ptr) -> i32 [binding=weak, object=_ZN6holderIiE7doubledEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load ptr $this
    %t2 = call i32 @holder_int___quadrupled(%t1)
    %t3 = binary div i32 %t2, 2
    return i32 %t3
}
function @holder_int___quadrupled(%this : ptr) -> i32 [binding=weak, object=_ZN6holderIiE10quadrupledEv] {
  slot $this : ptr

