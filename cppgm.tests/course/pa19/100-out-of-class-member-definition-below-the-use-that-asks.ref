function @holder_char___quadrupled(%this : ptr) -> i32 [binding=weak, object=_ZN6holderIcE10quadrupledEv] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load ptr $this
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load i8 %t2
    %t4 = load ptr $this
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = load i8 %t5
    %t7 = convert sext i32 i8 %t3
    %t8 = convert sext i32 i8 %t6
    %t9 = binary add i32 %t7, %t8
    %t10 = load ptr $this
    %t11 = index i8 [projection=field] %t10, 0
    %t12 = load i8 %t11
    %t13 = convert sext i32 i8 %t12
    %t14 = binary add i32 %t9, %t13
    %t15 = load ptr $this
    %t16 = index i8 [projection=field] %t15, 0
    %t17 = load i8 %t16
    %t18 = convert sext i32 i8 %t17
