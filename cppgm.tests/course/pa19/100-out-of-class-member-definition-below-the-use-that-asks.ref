    %t3 = load i32 %t2
    %t4 = load ptr $this
    %t5 = index i8 [projection=field] %t4, 0
    %t6 = load i32 %t5
    %t7 = binary add i32 %t3, %t6
    %t8 = load ptr $this
    %t9 = index i8 [projection=field] %t8, 0
    %t10 = load i32 %t9
    %t11 = binary add i32 %t7, %t10
    %t12 = load ptr $this
    %t13 = index i8 [projection=field] %t12, 0
    %t14 = load i32 %t13
    %t15 = binary add i32 %t11, %t14
    return i32 %t15
