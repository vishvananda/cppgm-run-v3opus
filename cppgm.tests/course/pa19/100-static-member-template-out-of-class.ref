global @counter__base : i32 [binding=strong, object=_ZN7counter4baseE] = 40

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @counter__raised(2)
    %t2 = binary sub i32 %t1, 42
    return i32 %t2
}
function @counter__raised(%step : i32) -> i32 [binding=weak, object=_ZN7counter6raisedIiEEiT_] {
  slot $step : i32

  block ^entry:
    store i32 %step, $step
    %t1 = load i32 @counter__base
    %t2 = load i32 $step
    %t3 = binary add i32 %t1, %t2
    return i32 %t3
}
