function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $one : obj<4x4>
  slot $two : i32

  block ^entry:
    %t1 = addr $one
    %t2 = addr $one
    %t3 = index i8 [projection=field] %t2, 0
    store i32 20, %t3
    store i32 2, $two
    %t4 = addr $one
    %t5 = call i32 @wrapped__operator_(%t4, 2)
    %t6 = addr $one
    %t7 = addr $two
    %t8 = call i32 @operator_(%t6, %t7)
    %t9 = binary add i32 %t5, %t8
    %t10 = binary sub i32 %t9, 44
    return i32 %t10
}
