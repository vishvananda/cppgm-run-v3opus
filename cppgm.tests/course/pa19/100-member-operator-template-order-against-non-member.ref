    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load i32 %t2
    %t4 = load i32 $step
    %t5 = binary add i32 %t3, %t4
    return i32 %t5
}
function @operator_(%held : ptr [pass=reference], %step : ptr) -> i32 [binding=weak, object=_ZplIiEiRK7wrappedPT_] {
  slot $held : ptr
