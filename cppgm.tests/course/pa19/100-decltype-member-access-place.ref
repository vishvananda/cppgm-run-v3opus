function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $one : obj<4x4>
  slot $copy : i32
  slot $argobj__1 : obj<4x4>

  block ^entry:
    %t1 = addr $one
    %t2 = addr $one
    %t3 = index i8 [projection=field] %t2, 0
    store i32 42, %t3
    store i32 0, $copy
    %t4 = addr $argobj__1
    %t5 = addr $one
    copyobj 4x4 %t5, %t4
    %t6 = call i32 @peek($argobj__1)
    store i32 %t6, $copy
    %t7 = load i32 $copy
    %t8 = binary sub i32 %t7, 42
    return i32 %t8
}
function @peek(%box : obj<4x4>) -> i32 [binding=weak, object=_Z4peekI4cellEDTdtfp_4slotET_] {
  slot $box : obj<4x4>

  block ^entry:
    %t1 = addr $box
    copyobj 4x4 %box, %t1
    %t2 = addr $box
    %t3 = index i8 [projection=field] %t2, 0
    %t4 = load i32 %t3
    return i32 %t4
}
