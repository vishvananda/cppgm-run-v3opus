function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $two : ptr
  slot $none : ptr
  slot $three : ptr

  block ^entry:
    %t1 = addr @count
    %t2 = unary decay ptr %t1
    store ptr %t2, $two
    %t3 = load ptr $two
    %t4 = call i32 %t3(1, 97) as (%arg0 : i32, %arg1 : i8) -> i32
    %t5 = cmp ne i32 %t4, 2
    branch %t5, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t6 = addr @count__ov2
    %t7 = unary decay ptr %t6
    store ptr %t7, $none
    %t8 = load ptr $none
    %t9 = call i32 %t8() as () -> i32
    %t10 = cmp ne i32 %t9, 0
    branch %t10, ^if_then_4, ^if_else_5

  block ^if_then_4:
    return i32 2

  block ^if_else_5:
    jump ^if_end_6

  block ^if_end_6:
    %t11 = addr @lead
    %t12 = unary decay ptr %t11
    store ptr %t12, $three
    %t13 = load ptr $three
    %t14 = call i32 %t13(4, 97, 5) as (%arg0 : i32, %arg1 : i8, %arg2 : i64) -> i32
    %t15 = cmp ne i32 %t14, 6
    branch %t15, ^if_then_7, ^if_else_8

  block ^if_then_7:
    return i32 3

  block ^if_else_8:
    jump ^if_end_9

  block ^if_end_9:
    return i32 0
}
function @count(%args : i32, %args__pack2 : i8) -> i32 [binding=weak, object=_Z5countIJicEEiDpT_] {
  slot $args : i32
  slot $args__pack2 : i8

  block ^entry:
    store i32 %args, $args
    store i8 %args__pack2, $args__pack2
    %t1 = const i64 2
    %t2 = convert trunc i32 i64 %t1
    return i32 %t2
}
function @count__ov2() -> i32 [binding=weak, object=_Z5countv] {
  block ^entry:
    %t1 = const i64 0
    %t2 = convert trunc i32 i64 %t1
    return i32 %t2
}
function @lead(%first : i32, %rest : i8, %rest__pack2 : i64) -> i32 [binding=weak, object=_Z4leadIiJclEEiT_DpT0_] {
  slot $first : i32
  slot $rest : i8
  slot $rest__pack2 : i64

  block ^entry:
    store i32 %first, $first
    store i8 %rest, $rest
    store i64 %rest__pack2, $rest__pack2
    %t1 = load i32 $first
    %t2 = const i64 2
    %t3 = convert trunc i32 i64 %t2
    %t4 = binary add i32 %t1, %t3
    return i32 %t4
}
