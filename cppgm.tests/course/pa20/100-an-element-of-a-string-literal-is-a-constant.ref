function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $bound : obj<12x4>
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64
  slot $land__5 : i64
  slot $land__6 : i64

  block ^entry:
    %t1 = cmp eq i32 98, 98
    branch %t1, ^land_rhs_16, ^land_short_17

  block ^land_rhs_16:
    %t2 = cmp eq i32 98, 98
    %t3 = cmp ne i64 %t2, 0
    store i64 %t3, $land__6
    jump ^land_end_18

  block ^land_short_17:
    store i64 0, $land__6
    jump ^land_end_18

  block ^land_end_18:
    %t4 = load i64 $land__6
    branch %t4, ^land_rhs_13, ^land_short_14

  block ^land_rhs_13:
    %t5 = cmp eq i32 120, 120
    %t6 = cmp ne i64 %t5, 0
    store i64 %t6, $land__5
    jump ^land_end_15

  block ^land_short_14:
    store i64 0, $land__5
    jump ^land_end_15

  block ^land_end_15:
    %t7 = load i64 $land__5
    branch %t7, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t8 = cmp eq i32 97, 97
    %t9 = cmp ne i64 %t8, 0
    store i64 %t9, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t10 = load i64 $land__4
    branch %t10, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t11 = cmp eq i32 122, 122
    %t12 = cmp ne i64 %t11, 0
    store i64 %t12, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t13 = load i64 $land__3
    branch %t13, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t14 = const i64 12
    %t15 = const i64 4
    %t16 = binary udiv i64 %t14, %t15
    %t17 = convert sext i64 i32 3
    %t18 = cmp eq i64 %t16, %t17
    %t19 = cmp ne i64 %t18, 0
    store i64 %t19, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t20 = load i64 $land__2
    branch %t20, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t21 = load i32 $cond__1
    return i32 %t21
}
