global @narrowed : i16 [binding=internal, object=_ZL8narrowed] = 42
global @sized [binding=strong, object=_Z5sized] = {
  zero 12
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = const i64 12
    %t2 = const i64 4
    %t3 = convert sext i64 i32 3
    %t4 = binary mul i64 %t3, %t2
    %t5 = cmp ne i64 %t1, %t4
    branch %t5, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t6 = cmp ne i32 3, 3
    branch %t6, ^if_then_4, ^lor_rhs_7

  block ^lor_rhs_7:
    %t7 = cmp ne i32 4, 4
    branch %t7, ^if_then_4, ^if_else_5

  block ^if_then_4:
    return i32 2

  block ^if_else_5:
    jump ^if_end_6

  block ^if_end_6:
    %t8 = cmp ne i32 3, 3
    branch %t8, ^if_then_8, ^if_else_9

  block ^if_then_8:
    return i32 3

  block ^if_else_9:
    jump ^if_end_10

  block ^if_end_10:
    %t9 = cmp ne i32 7, 7
    branch %t9, ^if_then_11, ^if_else_12

  block ^if_then_11:
    return i32 4

  block ^if_else_12:
    jump ^if_end_13

  block ^if_end_13:
    return i32 0
}
