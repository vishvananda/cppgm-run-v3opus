function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = convert sext i64 i32 1
    %t2 = cmp ne i64 1, %t1
    branch %t2, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t3 = call i64 @read()
    %t4 = const i64 8
    %t5 = cmp ne i64 %t3, %t4
    branch %t5, ^if_then_4, ^if_else_5

  block ^if_then_4:
    return i32 2

  block ^if_else_5:
    jump ^if_end_6

  block ^if_end_6:
    %t6 = cmp ne i32 0, 0
    branch %t6, ^if_then_7, ^if_else_8

  block ^if_then_7:
    return i32 3

  block ^if_else_8:
    jump ^if_end_9

  block ^if_end_9:
    %t7 = cmp ne i32 1, 1
    branch %t7, ^if_then_10, ^if_else_11

  block ^if_then_10:
    return i32 4

  block ^if_else_11:
    jump ^if_end_12

  block ^if_end_12:
    %t8 = cmp ne i32 2, 2
    branch %t8, ^if_then_13, ^if_else_14

  block ^if_then_13:
    return i32 5

  block ^if_else_14:
    jump ^if_end_15

  block ^if_end_15:
    %t9 = cmp ne i32 7, 7
    branch %t9, ^if_then_16, ^if_else_17

  block ^if_then_16:
    return i32 6

  block ^if_else_17:
    jump ^if_end_18

  block ^if_end_18:
    %t10 = cmp ne i32 1, 1
    branch %t10, ^if_then_19, ^if_else_20

  block ^if_then_19:
    return i32 7

  block ^if_else_20:
    jump ^if_end_21

  block ^if_end_21:
    return i32 0
}
function @read() -> i64 [binding=weak, object=_Z4readIlEmv] {
  block ^entry:
    return i64 8
}
