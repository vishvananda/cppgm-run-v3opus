function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $room : obj<8x4>
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = const i64 8
    %t2 = const i64 4
    %t3 = binary udiv i64 %t1, %t2
    %t4 = convert sext i64 i32 2
    %t5 = cmp eq i64 %t3, %t4
    branch %t5, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t6 = cmp eq i32 4, 4
    %t7 = cmp ne i64 %t6, 0
    store i64 %t7, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t8 = load i64 $land__2
    branch %t8, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t9 = load i32 $cond__1
    return i32 %t9
}
