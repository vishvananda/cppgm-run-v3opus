function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $i : obj<4x4>
  slot $c : obj<1x1>
  slot $room : obj<12x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $i
    %t2 = addr $c
    %t3 = const i64 12
    %t4 = const i64 4
    %t5 = binary udiv i64 %t3, %t4
    %t6 = convert sext i64 i32 3
    %t7 = cmp eq i64 %t5, %t6
    branch %t7, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t8 = load i32 $cond__1
    return i32 %t8
}
