global @parenthesized : i32 [binding=internal, object=_ZL13parenthesized] = 3
global @braced : i32 [binding=internal, object=_ZL6braced] = 4
global @direct : i32 [binding=internal, object=_ZL6direct] = 1
global @by_paren [binding=strong, object=_Z8by_paren] = {
  zero 12
}
global @by_brace [binding=strong, object=_Z8by_brace] = {
  zero 16
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = const i64 12
    %t2 = const i64 4
    %t3 = convert sext i64 i32 3
    %t4 = binary mul i64 %t3, %t2
    %t5 = cmp ne i64 %t1, %t4
    branch %t5, ^if_then_1, ^if_else_2

  block ^if_then_1:
    return i32 1

  block ^if_else_2:
    jump ^if_end_3

  block ^if_end_3:
    %t6 = const i64 16
    %t7 = const i64 4
    %t8 = convert sext i64 i32 4
    %t9 = binary mul i64 %t8, %t7
    %t10 = cmp ne i64 %t6, %t9
    branch %t10, ^if_then_4, ^if_else_5

  block ^if_then_4:
    return i32 2

  block ^if_else_5:
    jump ^if_end_6

  block ^if_end_6:
    %t11 = cmp ne i32 3, 3
    branch %t11, ^if_then_7, ^if_else_8

  block ^if_then_7:
    return i32 3

  block ^if_else_8:
    jump ^if_end_9

  block ^if_end_9:
    %t12 = cmp ne i32 4, 4
    branch %t12, ^if_then_10, ^if_else_11

  block ^if_then_10:
    return i32 4

  block ^if_else_11:
    jump ^if_end_12

  block ^if_end_12:
    return i32 0
}
