function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : i32
  slot $b : i32
  slot $c : i64
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    store i32 1, $a
    store i32 2, $b
    store i64 3, $c
    %t1 = load i32 $a
    %t2 = load i32 $b
    %t3 = binary add i32 %t1, %t2
    %t4 = cmp eq i32 %t3, 3
    branch %t4, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t5 = load i64 $c
    %t6 = cmp eq i64 %t5, 3
    %t7 = cmp ne i64 %t6, 0
    store i64 %t7, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t8 = load i64 $land__2
    branch %t8, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t9 = load i32 $cond__1
    return i32 %t9
}
