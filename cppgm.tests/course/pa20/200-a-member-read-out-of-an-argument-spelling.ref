global @subobject : i32 [binding=strong, object=_Z9subobject] = 2
global @called : i32 [binding=strong, object=_Z6called] = 7
global @nested : i32 [binding=strong, object=_Z6nested] = 7
global @through : i32 [binding=strong, object=_Z7through] = 7
global @constructed : i32 [binding=strong, object=_Z11constructed] = 18
global @arithmetic : i32 [binding=strong, object=_Z10arithmetic] = 10

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = load i32 @subobject
    %t2 = load i32 @called
    %t3 = binary add i32 %t1, %t2
    %t4 = load i32 @nested
    %t5 = binary add i32 %t3, %t4
    %t6 = load i32 @through
    %t7 = binary add i32 %t5, %t6
    %t8 = load i32 @constructed
    %t9 = binary add i32 %t7, %t8
    %t10 = load i32 @arithmetic
    %t11 = binary add i32 %t9, %t10
    return i32 %t11
}
