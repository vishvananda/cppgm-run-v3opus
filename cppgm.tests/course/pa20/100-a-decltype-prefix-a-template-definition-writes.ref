function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $o : obj<16x8>
  slot $d : obj<4x4>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $o
    %t2 = addr $o
    %t3 = index i8 [projection=field] %t2, 0
    store i32 1, %t3
    %t4 = addr $o
    %t5 = index i8 [projection=field] %t4, 8
    store i64 2, %t5
    %t6 = addr $d
    %t7 = addr $d
    %t8 = index i8 [projection=field] %t7, 0
    store i32 3, %t8
    %t9 = addr $o
    %t10 = index i8 [projection=field] %t9, 0
    %t11 = load i32 %t10
    %t12 = addr $o
    %t13 = index i8 [projection=field] %t12, 8
    %t14 = load i64 %t13
    %t15 = convert sext i64 i32 %t11
    %t16 = binary add i64 %t15, %t14
    %t17 = addr $d
    %t18 = index i8 [projection=field] %t17, 0
    %t19 = load i32 %t18
    %t20 = convert sext i64 i32 %t19
    %t21 = binary add i64 %t16, %t20
    %t22 = cmp eq i64 %t21, 6
    branch %t22, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t23 = load i32 $cond__1
    return i32 %t23
}
