global @lower : i32 [binding=internal, object=_ZL5lower] = 1
global @higher : i32 [binding=internal, object=_ZL6higher] = 2

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : i32
  slot $b : i32
  slot $c : i32
  slot $d : i32
  slot $e : i32
  slot $f : i32
  slot $g : i32

  block ^entry:
    store i32 0, $a
    store i32 0, $b
    store i32 0, $c
    store i32 0, $d
    store i32 0, $e
    store i32 0, $f
    store i32 0, $g
    %t1 = load i32 $a
    %t2 = load i32 $b
    %t3 = binary add i32 %t1, %t2
    %t4 = load i32 $c
    %t5 = binary add i32 %t3, %t4
    %t6 = load i32 $d
    %t7 = binary add i32 %t5, %t6
    %t8 = load i32 $e
    %t9 = binary add i32 %t7, %t8
    %t10 = load i32 $f
    %t11 = binary add i32 %t9, %t10
    %t12 = load i32 $g
    %t13 = binary add i32 %t11, %t12
    return i32 %t13
}
