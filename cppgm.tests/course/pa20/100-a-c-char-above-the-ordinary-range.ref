global @widened : i64 [binding=strong, object=_Z7widened] = -1
global @narrowed : i32 [binding=strong, object=_Z8narrowed] = -1

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $held : i64
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64
  slot $land__4 : i64

  block ^entry:
    store i64 -1, $held
    %t1 = load i64 $held
    %t2 = unary neg i32 1
    %t3 = convert sext i64 i32 %t2
    %t4 = cmp eq i64 %t1, %t3
    branch %t4, ^land_rhs_10, ^land_short_11

  block ^land_rhs_10:
    %t5 = load i64 @widened
    %t6 = unary neg i32 1
    %t7 = convert sext i64 i32 %t6
    %t8 = cmp eq i64 %t5, %t7
    %t9 = cmp ne i64 %t8, 0
    store i64 %t9, $land__4
    jump ^land_end_12

  block ^land_short_11:
    store i64 0, $land__4
    jump ^land_end_12

  block ^land_end_12:
    %t10 = load i64 $land__4
    branch %t10, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t11 = load i32 @narrowed
    %t12 = unary neg i32 1
    %t13 = cmp eq i32 %t11, %t12
    %t14 = cmp ne i64 %t13, 0
    store i64 %t14, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t15 = load i64 $land__3
    branch %t15, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t16 = cmp eq i32 16873, 16873
    %t17 = cmp ne i64 %t16, 0
    store i64 %t17, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t18 = load i64 $land__2
    branch %t18, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t19 = load i32 $cond__1
    return i32 %t19
}
