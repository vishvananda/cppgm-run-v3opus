start:
	move64 bp sp;
	call fn__main;
	syscall1 t64 60 x64;

fn__main:
	isub64 sp sp 8;
	move64 [sp] bp;
	move64 bp sp;
	isub64 sp sp 24;
fn__main__entry:
	move64 x64 1;
	move8 [bp-8] x8;
	move64 x64 0;
	move8 x8 [bp-8];
	move8 t8 56;
	lshift64 x64 x64 t8;
	srshift64 x64 x64 t8;
	ieq64 z8 x64 0;
	jumpif z8 fn__main__skipped;
	jump fn__main__taken;
fn__main__taken:
	move64 x64 4;
	move64 [bp-16] x64;
	move64 x64 [bp-16];
	jump fn__main__epilogue;
fn__main__skipped:
	move64 x64 5;
	move64 [bp-24] x64;
	move64 x64 [bp-24];
	jump fn__main__epilogue;
fn__main__epilogue:
	move64 sp bp;
	move64 bp [sp];
	iadd64 sp sp 8;
	ret;
