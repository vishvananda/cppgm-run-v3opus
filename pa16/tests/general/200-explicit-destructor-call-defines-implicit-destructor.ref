global @order : i32 [binding=strong, object=_Z5order] = zero

function @destroy(%p : ptr) -> void [binding=strong, object=_Z7destroyP3Box] {
  slot $p : ptr

  block ^entry:
    store ptr %p, $p
    %t1 = load ptr $p
    call void @Box___Box(%t1)
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $storage : obj<8x1>
  slot $p : ptr
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $storage
    %t2 = unary decay ptr %t1
    store ptr %t2, $p
    %t3 = load ptr $p
    call void @destroy(%t3)
    %t4 = load i32 @order
    %t5 = cmp eq i32 %t4, 2
    branch %t5, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t6 = load i32 $cond__1
    return i32 %t6
}
function @Box___Box(%this : ptr) -> void [binding=weak, object=_ZN3BoxD1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    eh_cleanup ^destructor_cleanup_1
    eh_end
    %t1 = load ptr $this
    %t2 = index i8 [projection=field] %t1, 0
    call void @Held___Held(%t2)
    jump ^destructor_end_2

  block ^destructor_cleanup_1:
    %t3 = load ptr $this
    %t4 = index i8 [projection=field] %t3, 0
    call void @Held___Held(%t4)
    eh_end
    resume

  block ^destructor_end_2:
    return void
}
function @Held___Held(%this : ptr) -> void [binding=weak, object=_ZN4HeldD1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load i32 @order
    %t2 = binary mul i32 %t1, 3
    %t3 = binary add i32 %t2, 2
    store i32 %t3, @order
    return void
}
alias object _ZN3BoxD2Ev = @Box___Box
alias object _ZN4HeldD2Ev = @Held___Held
