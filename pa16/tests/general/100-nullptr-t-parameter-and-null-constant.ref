global @spelled : i64 [binding=strong, object=_Z7spelled] = nullptr
global @address : ptr [binding=strong, object=_Z7address] = nullptr

function @same(%a : i64, %b : i64) -> u8 [binding=strong, object=_Z4sameDnDn] {
  slot $a : i64
  slot $b : i64

  block ^entry:
    store i64 %a, $a
    store i64 %b, $b
    %t1 = load i64 $a
    %t2 = load i64 $b
    %t3 = cmp eq i64 %t1, %t2
    return u8 %t3
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $from_zero : i64
  slot $reached : ptr
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64

  block ^entry:
    store i64 0, $from_zero
    %t1 = load i64 @spelled
    %t2 = copy ptr %t1
    store ptr %t2, $reached
    %t3 = call u8 @same(nullptr, 0)
    branch %t3, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t4 = load ptr $reached
    %t5 = cmp eq ptr %t4, 0
    %t6 = cmp ne i64 %t5, 0
    store i64 %t6, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t7 = load i64 $land__3
    branch %t7, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t8 = load i64 $from_zero
    %t9 = cmp eq i64 %t8, nullptr
    %t10 = cmp ne i64 %t9, 0
    store i64 %t10, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t11 = load i64 $land__2
    branch %t11, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t12 = load i32 $cond__1
    return i32 %t12
}
