function @free_add(%given : i32) -> i32 [binding=strong, object=_Z8free_addi] {
  slot $given : i32

  block ^entry:
    store i32 %given, $given
    %t1 = load i32 $given
    %t2 = binary add i32 %t1, 1
    return i32 %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $a : obj<4x4>
  slot $cond__1 : i32
  slot $land__2 : i64
  slot $land__3 : i64

  block ^entry:
    %t1 = addr $a
    %t2 = addr $a
    %t3 = index i8 [projection=field] %t2, 0
    store i32 2, %t3
    %t4 = addr $a
    %t5 = call i32 @adder__add(%t4, 3)
    %t6 = cmp eq i32 %t5, 5
    branch %t6, ^land_rhs_7, ^land_short_8

  block ^land_rhs_7:
    %t7 = call i32 @adder__twice(2)
    %t8 = cmp eq i32 %t7, 4
    %t9 = cmp ne i64 %t8, 0
    store i64 %t9, $land__3
    jump ^land_end_9

  block ^land_short_8:
    store i64 0, $land__3
    jump ^land_end_9

  block ^land_end_9:
    %t10 = load i64 $land__3
    branch %t10, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t11 = call i32 @free_add(1)
    %t12 = cmp eq i32 %t11, 2
    %t13 = cmp ne i64 %t12, 0
    store i64 %t13, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t14 = load i64 $land__2
    branch %t14, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t15 = load i32 $cond__1
    return i32 %t15
}
function @adder__add(%this : ptr, %given : i32) -> i32 [binding=weak, object=_ZNK5adder3addEi] {
  slot $this : ptr
  slot $given : i32

  block ^entry:
    store ptr %this, $this
    store i32 %given, $given
    %t1 = load ptr $this
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load i32 %t2
    %t4 = load i32 $given
    %t5 = binary add i32 %t3, %t4
    return i32 %t5
}
function @adder__twice(%given : i32) -> i32 [binding=weak, object=_ZN5adder5twiceEi] {
  slot $given : i32

  block ^entry:
    store i32 %given, $given
    %t1 = load i32 $given
    %t2 = load i32 $given
    %t3 = binary add i32 %t1, %t2
    return i32 %t3
}
