    %t5 = addr $p
    %t6 = index i8 [projection=field] %t5, 0
    %t7 = load f64 %t6
    %t8 = cmp eq f64 %t7, .5
    branch %t8, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t9 = addr $p
    %t10 = index i8 [projection=field] %t9, 8
    %t11 = load f32 %t10
    %t12 = cmp eq f32 %t11, 1.875f
    %t13 = cmp ne i64 %t12, 0
    store i64 %t13, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t14 = load i64 $land__2
    branch %t14, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t15 = load i32 $cond__1
    return i32 %t15
}
