function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $deep : obj<1x1>
  slot $quiet : obj<1x1>
  slot $loud : obj<4x4>
  slot $wrote : obj<1x1>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $deep
    %t2 = addr $quiet
    %t3 = addr $loud
    call void @HoldsLoud__HoldsLoud(%t3)
    %t4 = addr $wrote
    call void @WroteBody__WroteBody(%t4)
    %t5 = addr $loud
    %t6 = index i8 [projection=field] %t5, 0
    %t7 = index i8 [projection=field] %t6, 0
    %t8 = load i32 %t7
    %t9 = cmp eq i32 %t8, 4
    branch %t9, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t10 = load i32 $cond__1
    return i32 %t10
}
