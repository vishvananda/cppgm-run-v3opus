global @shared [binding=strong, object=_Z6shared] = {
  zero 4
}

function @wipe(%p : ptr) -> void [binding=strong, object=_Z4wipeP3Box] {
  slot $p : ptr

  block ^entry:
    store ptr %p, $p
    %t1 = load ptr $p
    call void @Box___Box(%t1)
    %t2 = load ptr $p
    call void @Box___Box(%t2)
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
