global @order : i32 [binding=strong, object=_Z5order] = zero

function @Box___Box(%this : ptr) -> void [binding=weak, object=_ZN3BoxD1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    eh_cleanup ^destructor_cleanup_1
    %t1 = load i32 @order
    %t2 = binary mul i32 %t1, 3
    %t3 = binary add i32 %t2, 1
    store i32 %t3, @order
    eh_end
    %t4 = load ptr $this
    %t5 = index i8 [projection=field] %t4, 0
    call void @Held___Held(%t5)
    jump ^destructor_end_2

  block ^destructor_cleanup_1:
    %t6 = load ptr $this
    %t7 = index i8 [projection=field] %t6, 0
    call void @Held___Held(%t7)
    eh_end
    resume

  block ^destructor_end_2:
    return void
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $box : obj<1x1>
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $box
    %t2 = addr $box
    call void @Box___Box(%t2)
    %t3 = load i32 @order
    %t4 = cmp eq i32 %t3, 5
    branch %t4, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t5 = load i32 $cond__1
    return i32 %t5
}
function @Held___Held(%this : ptr) -> void [binding=weak, object=_ZN4HeldD1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load i32 @order
    %t2 = binary mul i32 %t1, 3
    %t3 = binary add i32 %t2, 2
    store i32 %t3, @order
